#version 450
// FLASH_ATTN çıktı: softmax(s) ile V toplamı, sonra gate ve 8 bit. 2048 eleman: 8 şerit = 1 blok, 64 şerit = 1 başlık
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint vv; uint s; uint stride; uint gate; uint nq; uint nd; } p;
void main() {
    uint h = gl_WorkGroupID.x, lane = gl_LocalInvocationIndex;
    uint n = par.n_cells, sb = p.s + h * p.stride, kh = h / 4u;
    float m = -1e30;
    if (lane == 0u) for (uint c = 0u; c < n; c++) m = max(m, f[sb + c]);
    m = subgroupBroadcast(m, 0u);
    float tot = 0.0;
    vec4 acc = vec4(0.0);
    uint iv = p.vv / 4u + lane + kh * 64u;
    for (uint c = 0u; c < n; c++) {
        float w = exp(f[sb + c] - m);
        tot += w;
        acc += w * v[iv + c * 128u];
    }
    vec4 y = (acc / tot) * sigmoid4(v[p.gate / 4u + h * 128u + 64u + lane]);
    vec4 am = abs(y);
    float mx = subgroupClusteredMax(max(max(am.x, am.y), max(am.z, am.w)), 8u);
    float id = mx != 0.0 ? 127.0 / mx : 0.0;
    u[p.nq + h * 64u + lane] = pack8(y, id);
    if ((lane & 7u) == 0u) f[p.nd + h * 8u + lane / 8u] = dq16(mx / 127.0);
}
