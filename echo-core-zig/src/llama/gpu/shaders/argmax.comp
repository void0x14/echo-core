#version 450
// Hiyerarşik argmax: her dalga 64 değerin en büyüğünü ve kimliğini yazar; eşitlikte küçük kimlik (CPU greedy ile aynı).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint sv; uint si; uint dv; uint di; uint n; } p;
void main() {
    uint g = gl_WorkGroupID.x, lane = gl_LocalInvocationIndex, i = g * 64u + lane;
    if (i >= p.n) return;
    float val = f[p.sv + i];
    uint idx = p.si == 0u ? i : u[p.si + i];
    float m = subgroupMax(val);
    uint w = subgroupMin(val == m ? idx : 0xffffffffu);
    if (lane == 0u) { f[p.dv + g] = m; u[p.di + g] = w; }
}
