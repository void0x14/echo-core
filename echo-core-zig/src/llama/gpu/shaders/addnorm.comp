#version 450
// z = a + bs*b; y = rms_norm(z)*w; y blok başına 8 bite. k=1024, 2 şerit = 1 blok.
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint a; uint b; float bs; uint w; uint z; uint nq; uint nd; float eps; } p;
void main() {
    uint lane = gl_LocalInvocationIndex;
    uint ia = p.a / 4u + lane * 4u, ib = p.b / 4u + lane * 4u, iz = p.z / 4u + lane * 4u, iw = p.w / 4u + lane * 4u;
    vec4 z0 = v[ia] + p.bs * v[ib], z1 = v[ia + 1u] + p.bs * v[ib + 1u], z2 = v[ia + 2u] + p.bs * v[ib + 2u], z3 = v[ia + 3u] + p.bs * v[ib + 3u];
    v[iz] = z0; v[iz + 1u] = z1; v[iz + 2u] = z2; v[iz + 3u] = z3;
    float s = subgroupAdd(dot(z0, z0) + dot(z1, z1) + dot(z2, z2) + dot(z3, z3));
    float sc = 1.0 / sqrt(s / 1024.0 + p.eps);
    vec4 y0 = z0 * sc * v[iw], y1 = z1 * sc * v[iw + 1u], y2 = z2 * sc * v[iw + 2u], y3 = z3 * sc * v[iw + 3u];
    vec4 am = max(max(abs(y0), abs(y1)), max(abs(y2), abs(y3)));
    float m = subgroupClusteredMax(max(max(am.x, am.y), max(am.z, am.w)), 2u);
    float id = m != 0.0 ? 127.0 / m : 0.0;
    uq[p.nq / 4u + lane] = uvec4(pack8(y0, id), pack8(y1, id), pack8(y2, id), pack8(y3, id));
    if ((lane & 1u) == 0u) f[p.nd + lane / 2u] = dq16(m / 127.0);
}
