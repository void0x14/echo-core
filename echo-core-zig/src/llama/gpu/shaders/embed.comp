#version 450
// GET_ROWS(token_embd): k=1024, şerit başına 16 eleman
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint q; uint d; uint o; } p;
void main() {
    uint lane = gl_LocalInvocationIndex;
    uvec4 w = uq[p.q / 4u + par.token * 64u + lane];
    float d = wscale(p.d, par.token * 32u + lane / 2u);
    uint o = p.o / 4u + lane * 4u;
    v[o] = u8v(w.x) * d;
    v[o + 1u] = u8v(w.y) * d;
    v[o + 2u] = u8v(w.z) * d;
    v[o + 3u] = u8v(w.w) * d;
}
