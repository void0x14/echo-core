#version 450
// Token sonu: argmax'ı listeye yaz, sıradaki tokeni seç, sayaçları ilerlet. mode 1: hazır rastgele liste (bench).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 1) in;
layout(push_constant) uniform P { uint best; uint outlist; uint rnd; } p;
void main() {
    uint h = par.head, a = u[p.best];
    u[p.outlist + h] = a;
    par.token = par.mode == 0u ? a : u[p.rnd + h + 1u];
    par.head = h + 1u;
    par.n_cells = h + 2u;
    par.pos = float(h + 1u);
    par.ix = (h + 2u + 63u) / 64u;
}
